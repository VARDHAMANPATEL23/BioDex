# ==========================================
# BioDex API: Environment Variables Template
# ==========================================

# Your MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/biodex_db?retryWrites=true&w=majority

# Used for authenticating JSON Web Tokens (Sessions)
SECRET_KEY=your_secret_crypto_key_here

# Nvidia Inference Microservice (NIM) Model API Key
NVIDIA_API_KEY=nvapi-your_unique_api_key
